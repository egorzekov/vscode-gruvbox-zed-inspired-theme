{
  "name": "vscode-gruvbox-zed-inspired-theme",
  "displayName": "Zed Gruvbox",
  "description": "Gruvbox for VS Code and Cursor, inspired by the Zed editor's take on the palette.",
  "version": "1.0.0",
  "publisher": "egorzekov",
  "repository": {
    "type": "git",
    "url": "https://github.com/egorzekov/vscode-gruvbox-zed-inspired-theme.git"
  },
  "license": "MIT",
  "author": "Egor Zekov",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "assets/icon.png",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "gruvbox",
    "zed",
    "theme",
    "dark",
    "color-theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Zed Gruvbox Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/zed-gruvbox-dark.json"
      }
    ]
  },
  "scripts": {
    "build": "node src/build.ts",
    "typecheck": "tsc --noEmit",
    "prepackage": "pnpm run typecheck && pnpm run build",
    "package": "mkdir -p dist && vsce package --no-dependencies --out dist/",
    "clean": "rm -rf themes dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
